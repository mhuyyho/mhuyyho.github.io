# Public site URL (no trailing slash). Used for canonical, OG, hreflang, sitemap.
SITE_URL=https://mhuyyho.github.io

# Sub-path the site is served from. Leave blank for local dev and root-domain hosting.
# For a GitHub user site (mhuyyho.github.io), BASE_PATH should be '/' or empty.
BASE_PATH=

# --- Giscus (optional) ---
PUBLIC_GISCUS_ENABLED=false
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
